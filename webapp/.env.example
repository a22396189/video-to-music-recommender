# Copy this file to ".env.local" for local dev, and set the same keys as
# Environment Variables in the Vercel project dashboard for deployment.
# .env.local is git-ignored - never commit real keys.

# Google AI Studio -> https://aistudio.google.com/app/apikey
# Used both for frame captioning (Gemini vision, replaces the local BLIP model)
# and for the summary/genre steps.
GEMINI_API_KEY=your_google_ai_studio_key
GEMINI_MODEL=models/gemini-2.5-flash

# Last.fm (free, instant) -> https://www.last.fm/api/account/create
# Used for per-genre "top tracks". Leave blank to fall back to Apple charts / iTunes.
LASTFM_API_KEY=your_lastfm_api_key

# Spotify Developer Dashboard -> https://developer.spotify.com/dashboard (optional)
# NOTE: since 2026 the app owner needs Spotify Premium for the Web API to work.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
