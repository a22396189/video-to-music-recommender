# Copy this file to ".env" and fill in your own keys.
# .env is git-ignored - never commit real keys.
# Keep THIS file (.env.example) with placeholder values only.

# Google AI Studio -> https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_ai_studio_key
GEMINI_MODEL=models/gemini-2.5-flash

# Spotify Developer Dashboard -> https://developer.spotify.com/dashboard
# NOTE: since 2026 the app owner needs Spotify Premium for the Web API to work.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Last.fm (free, instant) -> https://www.last.fm/api/account/create
# Used for per-genre "top tracks". Leave blank to fall back to Apple charts.
LASTFM_API_KEY=your_lastfm_api_key
